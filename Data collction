#!/usr/bin/env python3
import subprocess
import time
import sys
import os
from datetime import datetime

# ── CONFIG ────────────────────────────────────────────
SERIAL_PORT  = "/dev/ttyAMA10"
BAUD_RATE    = 9600
POLL_SECONDS = 5
LOG_FILE     = "bms_log.csv"
# ──────────────────────────────────────────────────────

def read_bms():
    cmd = ["jbdtool", "-t", f"serial:{SERIAL_PORT},{BAUD_RATE}"]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
        output = result.stdout.strip()
    except subprocess.TimeoutExpired:
        print("ERROR: jbdtool timed out.")
        return None
    except FileNotFoundError:
        print("ERROR: jbdtool not found.")
        sys.exit(1)
    if not output:
        print("ERROR: No output from jbdtool.")
        return None
    data = {}
    for line in output.splitlines():
        parts = line.split(None, 1)
        if len(parts) == 2:
            data[parts[0]] = parts[1].strip()
    return data

def parse_temps(temp_str):
    try:
        return [float(t) for t in temp_str.split(",")]
    except:
        return []

def get_cells(data):
    cells = []
    i = 0
    while f"Cell{i+1}" in data:
        cells.append(float(data[f"Cell{i+1}"]))
        i += 1
    return cells

def estimate_runtime(remaining_ah, current_a):
    if current_a >= 0:
        return None
    hours = remaining_ah / abs(current_a)
    h = int(hours)
    m = int((hours - h) * 60)
    return f"{h}h {m}m"

def monitor_temp_alert(temps):
    if not temps:
        return
    max_temp = max(temps)
    for i, t in enumerate(temps):
        if t >= 45:
            print(f"\n🔥 CRITICAL: Probe {i+1} temp is {t:.1f}C — SHUTTING DOWN RISK!")
        elif t >= 35:
            print(f"\n⚠️  WARNING: Probe {i+1} temp is {t:.1f}C — getting hot!")

def display(data):
    voltage   = float(data.get("Voltage",           0))
    current   = float(data.get("Current",           0))
    pct       = int(  data.get("PercentCapacity",   0))
    remaining = float(data.get("RemainingCapacity", 0))
    temps     = parse_temps(data.get("Temps",       ""))
    cells     = get_cells(data)
    runtime   = estimate_runtime(remaining, current)
    now       = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    state     = "Charging" if current > 0 else "Discharging" if current < 0 else "Idle"

    print(f"\n{'─'*40}")
    print(f"  {now}")
    print(f"{'─'*40}")
    print(f"  Voltage      : {voltage:.2f} V")
    print(f"  State        : {state}")
    print(f"  Current      : {current:.2f} A")
    print(f"  Charge       : {pct}%  ({remaining:.1f} Ah remaining)")
    if temps:
        labels = [f"Probe {i+1}: {t:.1f}C" for i, t in enumerate(temps)]
        print(f"  Temperature  : {', '.join(labels)}")
    if runtime:
        print(f"  Est. Runtime : {runtime} remaining")
    elif current > 0:
        print(f"  Est. Runtime : charging")
    else:
        print(f"  Est. Runtime : idle")

    if cells:
        print(f"\n  --- Cell Voltages ---")
        for i, v in enumerate(cells):
            warn = "⚠️ " if v < 2.5 or v > 3.65 else "✓  "
            print(f"  {warn} Cell {i+1:2d} : {v:.3f} V")
        diff = max(cells) - min(cells)
        print(f"\n  Cell Min     : {min(cells):.3f} V")
        print(f"  Cell Max     : {max(cells):.3f} V")
        print(f"  Cell Diff    : {diff:.3f} V  {'⚠️  HIGH IMBALANCE' if diff > 0.05 else '✓ balanced'}")

    print(f"{'─'*40}")
    monitor_temp_alert(temps)
    return voltage, current, pct, remaining, temps, runtime, now

def log_csv(now, voltage, current, pct, remaining, temps, runtime):
    write_header = not os.path.exists(LOG_FILE)
    with open(LOG_FILE, "a") as f:
        if write_header:
            temp_headers = ",".join([f"temp{i+1}_c" for i in range(len(temps))])
            f.write(f"timestamp,voltage_v,current_a,percent,remaining_ah,{temp_headers},est_runtime\n")
        temp_vals = ",".join([str(t) for t in temps])
        f.write(f"{now},{voltage},{current},{pct},{remaining},{temp_vals},{runtime or ''}\n")

def main():
    print(f"JBD BMS Monitor - polling {SERIAL_PORT} every {POLL_SECONDS}s")
    print(f"Log file: {LOG_FILE}")
    print("Press Ctrl+C to stop.\n")

    try:
        voltage = 0
        while True:
            data = read_bms()
            if data:
                voltage, current, pct, remaining, temps, runtime, now = display(data)
                log_csv(now, voltage, current, pct, remaining, temps, runtime)
            time.sleep(POLL_SECONDS)

    except KeyboardInterrupt:
        print("\nStopping monitor...")

if __name__ == "__main__":
    main()



#include <Wire.h>
#include <math.h>

// ---- Thermistor config ----
#define RT0 10000
#define B   3977
#define VCC 5
#define R   1700

// ---- MPU6050 config ----
const int MPU6050_ADDR = 0x68;
int16_t AcX, AcY, AcZ, GyX, GyY, GyZ;
float axOffset, ayOffset, azOffset;
float gxOffset, gyOffset, gzOffset;

float readTempC() {
  float VRT = analogRead(A0);
  VRT = (5.00 / 1023.00) * VRT;
  float VR = VCC - VRT;
  float RT = VRT / (VR / R);
  float ln  = log(RT / RT0);
  float T0  = 25 + 273.15;
  float TX  = (1 / ((ln / B) + (1 / T0)));
  return TX - 273.15;
}

void readSensor(float &ax, float &ay, float &az, float &gx, float &gy, float &gz) {
  Wire.beginTransmission(MPU6050_ADDR);
  Wire.write(0x3B);
  Wire.endTransmission(false);
  Wire.requestFrom(MPU6050_ADDR, 14, true);

  AcX = Wire.read() << 8 | Wire.read();
  AcY = Wire.read() << 8 | Wire.read();
  AcZ = Wire.read() << 8 | Wire.read();
  Wire.read(); Wire.read();
  GyX = Wire.read() << 8 | Wire.read();
  GyY = Wire.read() << 8 | Wire.read();
  GyZ = Wire.read() << 8 | Wire.read();

  ax = (AcX / 16384.0) * 9.81;
  ay = (AcY / 16384.0) * 9.81;
  az = (AcZ / 16384.0) * 9.81;
  gx = GyX / 131.0;
  gy = GyY / 131.0;
  gz = GyZ / 131.0;
}

void calibrate() {
  float ax, ay, az, gx, gy, gz;
  axOffset = ayOffset = azOffset = 0;
  gxOffset = gyOffset = gzOffset = 0;

  for (int i = 0; i < 100; i++) {
    readSensor(ax, ay, az, gx, gy, gz);
    axOffset += ax; ayOffset += ay; azOffset += az;
    gxOffset += gx; gyOffset += gy; gzOffset += gz;
    delay(10);
  }

  axOffset /= 100; ayOffset /= 100; azOffset /= 100;
  gxOffset /= 100; gyOffset /= 100; gzOffset /= 100;
}

void setup() {
  Serial.begin(9600);
  Wire.begin();
  delay(100);

  Wire.beginTransmission(MPU6050_ADDR);
  Wire.write(0x6B);
  Wire.write(0x80);
  Wire.endTransmission(true);
  delay(100);

  Wire.beginTransmission(MPU6050_ADDR);
  Wire.write(0x6B);
  Wire.write(0x00);
  Wire.endTransmission(true);
  delay(50);

  calibrate();

  // Print CSV header
  Serial.println("timestamp_ms,ax_ms2,ay_ms2,az_ms2,gx_degs,gy_degs,gz_degs,temp_c");
}

void loop() {
  float ax, ay, az, gx, gy, gz;
  readSensor(ax, ay, az, gx, gy, gz);
  ax -= axOffset; ay -= ayOffset; az -= azOffset;
  gx -= gxOffset; gy -= gyOffset; gz -= gzOffset;

  float tempC = readTempC();

  // Print one CSV row per reading
  Serial.print(millis());        Serial.print(",");
  Serial.print(ax, 3);           Serial.print(",");
  Serial.print(ay, 3);           Serial.print(",");
  Serial.print(az, 3);           Serial.print(",");
  Serial.print(gx, 3);           Serial.print(",");
  Serial.print(gy, 3);           Serial.print(",");
  Serial.print(gz, 3);           Serial.print(",");
  Serial.println(tempC, 2);

  delay(333);
}
